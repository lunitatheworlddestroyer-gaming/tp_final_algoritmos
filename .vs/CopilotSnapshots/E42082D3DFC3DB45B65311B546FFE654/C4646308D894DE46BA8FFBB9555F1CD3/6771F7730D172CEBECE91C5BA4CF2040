        private void jugar_carta(PictureBox carta)
        {
            if (carta == null || carta.Tag == null)
            {
                return;
            }

            string nombre_carta = carta.Tag.ToString();
            if (string.IsNullOrWhiteSpace(nombre_carta))
            {
                return;
            }

            preguntar_e = true;
            preguntar_t = true;

            DialogResult r = MessageBox.Show($"¿Seguro queres jugar la carta {nombre_carta}?", "Jugar carta", MessageBoxButtons.YesNo, MessageBoxIcon.Question);
            if (r == DialogResult.Yes)
            {
                s = nombre_carta;
                input = true;
                carta.Tag = null;
                carta.Visible = false;
            }
        }

        private void cargar_imagen_carta(PictureBox p, string n)
        {
            string r = Path.Combine(Application.StartupPath, "assets", n + ".png");
            if (!File.Exists(r))
                r = Path.Combine(Application.StartupPath, "assets", "carta_error.png");

            if (!File.Exists(r))
            {
                p.Image = null;
                return;
            }

            try
            {
                using (var stream = File.OpenRead(r))
                    p.Image = Image.FromStream(stream);
            }
            catch (IOException)
            {
                p.Image = null;
            }
            catch (ArgumentException)
            {
                p.Image = null;
            }
            catch (OutOfMemoryException)
            {
                p.Image = null;
            }
        }

