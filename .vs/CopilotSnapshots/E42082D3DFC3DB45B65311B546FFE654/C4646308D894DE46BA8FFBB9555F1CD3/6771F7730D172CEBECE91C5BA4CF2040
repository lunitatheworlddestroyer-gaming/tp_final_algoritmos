        public void envido(Partida p, bool e, int id_turno)
        {
            string respuesta = "";

            while (respuesta != "si" || respuesta != "no")
            {
                e = !e;
                if (!e)
                {
                    respuesta = p.jugadores[id_turno + 1].preguntar_e(p.envido, p.valor_envido(p.jugadores[id_turno + 1]));
                    p.guardar_respuesta(respuesta);
                }
                else
                {
                    using (Form_envido form_envido = new Form_envido(true, partida))
                    {
                        DialogResult resultado = form_envido.ShowDialog();
                        if (resultado == DialogResult.Yes)
                        {
                            //quiso
                            respuesta = "si";
                        }
                        if (resultado == DialogResult.Cancel)
                        {
                            //no quiso
                            respuesta = "no";
                        }
                        if (resultado == DialogResult.OK)
                        {
                            //otras opciones
                            p = form_envido.partida;
                        }
                    }
                }

            }
            if (respuesta == "si")
            {
                p.quiso_envido = true;
                if (p.ganador_envido())
                {
                    p.nosotros = p.nosotros + p.puntos_envido(p.ganador_envido());
                }
                else
                {
                    p.ellos = p.ellos + p.puntos_envido(p.ganador_envido());
                }
            }
            else
            {
                p.quiso_envido = false;
                if (e)
                {
                    p.ellos = p.ellos + p.puntos_envido(p.ganador_envido());
                }
                else
                {
                    p.nosotros = p.nosotros + p.puntos_envido(p.ganador_envido());
                }
            }

        }
        public void loop_juego(Partida p)
        {
            Carta c;
            string r = "";
            while (p.nosotros < p.puntos || p.ellos < p.puntos)
            {
                p.nueva_ronda(p.id_mano);
                this.inicializar_ronda();
                int id_turno = p.id_mano;
                while (p.ganador_ronda() == null)
                {
                    while (p.cartas_en_mesa.Count() < p.jugadores.Count())
                    {
                        if (id_turno == 0)
                        {
                            if (p.vuelta == 1)
                            {
                                btn_envido.Enabled = true;
                                while (!preguntar_e)
                                {
                                    Application.DoEvents();
                                }
                                if (p.envido != Enums.Envido.no)
                                {
                                    this.envido(p, true, id_turno);
                                }
                            }

                            else
                            {
                                btn_envido.Enabled = false;
                            }
                            btn_truco.Enabled = true;
                            while (!preguntar_t)
                            {
                                Application.DoEvents();
                            }
                            r = p.jugadores[id_turno + 1].preguntar_t(p.truco);
                            if (r == "no")
                            {
                                p.quiso_truco = false;
                                p.nosotros = p.nosotros + p.puntos_truco();
                                p.ganador_primera = true;
                                p.ganador_segunda = true;
                                break;
                            }
                            if (r == "+1")
                            {
                                using (Form_truco form_truco = new Form_truco(partida))
                                {
                                    DialogResult resultado = form_truco.ShowDialog();
                                    if (resultado == DialogResult.Cancel)
                                    {
                                        //no quiso
                                        p.quiso_truco = false;
                                        p.ellos = p.ellos + p.puntos_truco();
                                        p.ganador_primera = true;
                                        p.ganador_segunda = true;
                                        break;
                                    }
                                    if (resultado == DialogResult.OK)
                                    {
                                        //otras opciones
                                        p = form_truco.partida;
                                        r = p.jugadores[id_turno + 1].preguntar_t(p.truco);
                                        if (r == "no")
                                        {
                                            p.quiso_truco = false;
                                            p.nosotros = p.nosotros + p.puntos_truco();
                                            p.ganador_primera = true;
                                            p.ganador_segunda = true;
                                            break;
                                        }
                                    }
                                }
                            }
                            r = "";

                            while (!input)
                            {
                                Application.DoEvents();
                            }
                            p = partida;
                            if (s == "mazo")
                            {
                                p.ellos = p.ellos + p.puntos_truco();
                                p.ganador_primera = false;
                                p.ganador_segunda = false;
                                break;
                            }

                            c = p.str_a_carta(s);
                            btn_truco.Enabled = false;
                            input = false;
                        }
                        else
                        {
                            btn_envido.Enabled = false;
                            //respuesta de bot
                            if (p.vuelta == 1)
                            {

                                r = p.jugadores[id_turno].cantar_envido(p.valor_envido(p.jugadores[id_turno]));
                                if (r != "no")
                                {
                                    p.guardar_respuesta(r);
                                    this.envido(p, false, id_turno);
                                }
                            }
                            else
                            {
                                r=p.jugadores[id_turno].cantar_truco();
                                if(r == "si")
                                {
                                    p.truco = Enums.Truco.truco;
                                    using (Form_truco form_truco = new Form_truco(partida))
                                    {
                                        DialogResult resultado = form_truco.ShowDialog();
                                        if (resultado == DialogResult.Cancel)
                                        {
                                            //no quiso
                                            p.quiso_truco = false;
                                            p.ellos = p.ellos + p.puntos_truco();
                                            p.ganador_primera = true;
                                            p.ganador_segunda = true;
                                            break;
                                        }
                                        if (resultado == DialogResult.OK)
                                        {
                                            //otras opciones
                                            p = form_truco.partida;
                                            r = p.jugadores[id_turno + 1].preguntar_t(p.truco);
                                            if (r == "no")
                                            {
                                                p.quiso_truco = false;
                                                p.nosotros = p.nosotros + p.puntos_truco();
                                                p.ganador_primera = true;
                                                p.ganador_segunda = true;
                                                break;
                                            }
                                            else
                                            {
                                                using (Form_truco form_truco2 = new Form_truco(partida))
                                                {
                                                    DialogResult resultado2 = form_truco2.ShowDialog();
                                                    if (resultado == DialogResult.Cancel)
                                                    {
                                                        //no quiso
                                                        p.quiso_truco = false;
                                                        p.ellos = p.ellos + p.puntos_truco();
                                                        p.ganador_primera = true;
                                                        p.ganador_segunda = true;
                                                        break;
                                                    }

                                                }
                                            }

                                        }
                                    }
                                }

                            }
                            c = p.jugadores[id_turno].decidir_carta(p);
                            r = "";
                            if (s == "mazo") { break; }
                        }
                        lbl_nosotros.Text = $"Nosotros: {p.nosotros}";
                        lbl_ellos.Text = $"Ellos: {p.ellos}";
                        if (s == "mazo") { break; }
                        s = null;
                        c.id_jugador = id_turno;
                        cargar_cartas_mesa(c, p, id_turno);
                        p.cartas_en_mesa.Add(p.jugadores[id_turno].bajar_carta(c));
                        if (p.nosotros >= p.puntos || p.ellos >= p.puntos) { break; }
                        id_turno = (id_turno + 1) % p.jugadores.Count();


                    }
                    if (s == "mazo") { s = null; break; }
                    if (p.cartas_en_mesa.Count == 0) { break; }
                    if (p.nosotros >= p.puntos || p.ellos >= p.puntos) { break; }
                    id_turno = p.ganador_carta();
                    if (p.vuelta == 1)
                    {
                        p.ganador_primera = p.jugadores[p.ganador_carta()].equipo;
                    }
                    if (p.vuelta == 2)
                    {
                        p.ganador_segunda = p.jugadores[p.ganador_carta()].equipo;
                    }
                    if (p.vuelta == 3)
                    {
                        p.ganador_tercera = p.jugadores[p.ganador_carta()].equipo;
                    }
                    p.cartas_en_mesa.Clear();
                    p.vuelta++;
                }
                preguntar_e = false;
                p.id_mano = (p.id_mano + 1) % p.jugadores.Count();
                if (p.quiso_truco != false)
                {
                    if (p.ganador_ronda() == true)
                    {
                        p.nosotros = p.nosotros + p.puntos_truco();
                    }
                    else
                    {
                        if (p.ganador_ronda() != null)
                        {
                            p.ellos = p.ellos + p.puntos_truco();
                        }
                    }
                }
                p.cartas_en_mesa.Clear();
                if (p.nosotros >= p.puntos || p.ellos >= p.puntos) { break; }
            }
        }
