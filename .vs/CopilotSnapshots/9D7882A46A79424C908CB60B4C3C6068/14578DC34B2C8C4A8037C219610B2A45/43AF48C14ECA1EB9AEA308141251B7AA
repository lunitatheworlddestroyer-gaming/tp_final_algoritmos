using System;
using System.Collections.Generic;
using System.Linq;
using System.Runtime.CompilerServices;
using System.Text;
using System.Threading.Tasks;
using tp_final_algoritmos.Enums;

namespace tp_final_algoritmos.modelos
{
    public class Partida
    {
        private Mazo mazo;
        public int puntos; // es hasta 15 o hasta 30
        public bool con_flor = false;
        public Modo_partida modo_partida; // simple o torneo
        public int cant_jugadores;
        public int nosotros;
        public int ellos;
        public int id_mano;
        //id del jugador que empieza
        public List<Jugador> jugadores = new List<Jugador>();
        public List<Carta> cartas_jugadas { get; set; } = new List<Carta>();
        //cartas en la partida
        public List<Carta> cartas_en_mesa = new List<Carta>();
        //cartas en la mesa, en cada vuelta se reinicia
        public int vuelta;
        // 1, 2 y 3 como primera, segunda y tercera
        public bool? ganador_primera;
        public bool? ganador_segunda;
        public bool? ganador_tercera;
        public Envido envido;
        public Truco truco;
        public bool envido_cantado;
        public bool? quiso_envido;
        public bool? quiso_truco;
        public Partida(int c, int Puntos, Modo_partida modo, Jugador_humano player)
        {
            Random r = new Random();
            this.cant_jugadores = c;
            this.nosotros = 0;
            this.ellos = 0;
            this.id_mano = r.Next(0, c);
            this.puntos = Puntos;
            this.modo_partida = modo;
            this.jugadores = new List<Jugador>();
            this.jugadores.Add(player);
            bool e = true;
            for (int i = 1; i < c; i++)
            {
                e = !e;
                Jugador_bot bot = new Jugador_bot($"PC {i}", e, i);
                this.jugadores.Add(bot);
            }
            this.vuelta = 1;
            Mazo Mazo = new Mazo();
            this.mazo = Mazo;
            this.mazo.mezclar_mazo();
            this.mazo.repartir_cartas(this.jugadores);
            this.envido = Envido.no;
            this.truco = Truco.no;
            this.envido_cantado = false;
            this.quiso_envido = null;
            this.quiso_truco = null;
        }

        public void nueva_ronda(int i)
        {
            this.cartas_jugadas.Clear();
            this.cartas_en_mesa.Clear();
            foreach (Jugador j in this.jugadores)
            {
                j.mano.Clear();
            }
            this.vuelta = 1;
            this.ganador_primera = null;
            this.ganador_segunda = null;
            this.ganador_tercera = null;
            Mazo Mazo = new Mazo();
            this.mazo = Mazo;
            this.mazo.mezclar_mazo();
            this.mazo.repartir_cartas(this.jugadores);
            foreach (Jugador j in this.jugadores)
            {
                j.mirar_mano();
            }
            this.envido = Envido.no;
            this.truco = Truco.no;
            this.envido_cantado = false;
            id_mano = i;
            this.quiso_envido = null;
            this.quiso_truco = null;
        }
        public int valor_envido(Jugador j)
        {
            //si hay flor toma los mas grandes y los devuelve
            if (j.mano[0].palo == j.mano[1].palo && j.mano[0].palo == j.mano[2].palo)
            {
                if (j.mano[0].valor_envido > j.mano[2].valor_envido && j.mano[1].valor_envido > j.mano[2].valor_envido)
                {
                    return j.mano[0].valor_envido + j.mano[1].valor_envido;
                }
                if (j.mano[0].valor_envido > j.mano[1].valor_envido && j.mano[2].valor_envido > j.mano[1].valor_envido)
                {
                    return j.mano[0].valor_envido + j.mano[2].valor_envido;
                }
                if (j.mano[1].valor_envido > j.mano[0].valor_envido && j.mano[2].valor_envido > j.mano[0].valor_envido)
                {
                    return j.mano[2].valor_envido + j.mano[1].valor_envido;
                }
            }
            // con 2 cartas
            if (j.mano[0].palo == j.mano[1].palo)
            {
                return j.mano[0].valor_envido + j.mano[1].valor_envido;
            }
            if (j.mano[0].palo == j.mano[2].palo)
            {
                return j.mano[0].valor_envido + j.mano[2].valor_envido;
            }
            if (j.mano[1].palo == j.mano[2].palo)
            {
                return j.mano[2].valor_envido + j.mano[1].valor_envido;
            }
            //si no tiene cartas iguales
            if (j.mano[0].valor_envido >= j.mano[1].valor_envido)
            {
                if (j.mano[0].valor_envido >= j.mano[2].valor_envido)
                {
                    return j.mano[0].valor_envido;
                }
                else
                {
                    return j.mano[2].valor_envido;
                }

            }
            else
            {
                if (j.mano[1].valor_envido >= j.mano[2].valor_envido)
                {
                    return j.mano[1].valor_envido;
                }
                else
                {
                    return j.mano[2].valor_envido;
                }
            }
        }
        public bool ganador_envido()
        {
            Jugador j = this.jugadores[this.id_mano];
            foreach (Jugador j2 in this.jugadores)
            {
                if (this.valor_envido(j) < this.valor_envido(j2))
                {
                    j = j2;
                }
            }
            return j.equipo;
        }
        public int puntos_envido(bool ganador)
        {
            if (this.quiso_envido == true)
            {
                switch (this.envido)
                {
                    case Envido.no:
                        return 0;
                    case Envido.envido:
                        return 2;
                    case Envido.envido_envido:
                        return 4;
                    case Envido.real_envido:
                        return 3;
                    case Envido.envido_real_envido:
                        return 5;
                    case Envido.envido_envido_real_envido:
                        return 7;
                    case Envido.falta_envido:
                    case Envido.envido_falta_envido:
                    case Envido.envido_envido_falta_envido:
                    case Envido.real_envido_falta_envido:
                    case Envido.envido_real_envido_falta_envido:
                    case Envido.envido_envido_real_envido_falta_envido:
                        if (ganador)
                        {
                            return this.puntos - this.ellos;
                        }
                        else
                        {
                            return this.puntos - this.nosotros;
                        }
                    default:
                        return 0;

                }
            }
            else
            {
                switch (this.envido)
                {
                    case Envido.no:
                        return 0;
                    case Envido.envido:
                        return 1;
                    case Envido.envido_envido:
                        return 2;
                    case Envido.real_envido:
                        return 1;
                    case Envido.envido_real_envido:
                        return 2;
                    case Envido.envido_envido_real_envido:
                        return 4;
                    case Envido.falta_envido:
                        return 1;
                    case Envido.envido_falta_envido:
                        return 1;
                    case Envido.envido_envido_falta_envido:
                        return 2;
                    case Envido.real_envido_falta_envido:
                        return 1;
                    case Envido.envido_real_envido_falta_envido:
                        return 2;
                    case Envido.envido_envido_real_envido_falta_envido:
                        return 4;
                    default:
                        return 0;
                }
            }
        }
        public int puntos_truco()
        {
            switch (this.truco)
            {
                case Truco.no:
                    return 1;
                case Truco.truco:
                    return 2;
                case Truco.retruco:
                    return 3;
                case Truco.vale_4:
                    return 4;
                default:
                    return 1;
            }

        }
        public int ganador_carta()
        {
            Carta ganadora = this.cartas_en_mesa[0];
            foreach (Carta c in this.cartas_en_mesa)
            {
                if (c.valor_truco > ganadora.valor_truco)
                {
                    ganadora = c;
                }
            }
            return ganadora.id_jugador;
        }
        public bool? ganador_ronda()
        {
            if (this.vuelta == 2)
            {
                //para la segunda
                if (this.ganador_primera == true)
                {
                    if (this.ganador_segunda == true || this.ganador_segunda == null)
                    {
                        // ganamos nosotros
                        return true;
                    }
                    if (this.ganador_segunda == false)
                    {
                        return null;
                    }
                }
                if (this.ganador_primera == false)
                {
                    if (this.ganador_segunda == false || this.ganador_segunda == null)
                    {
                        //ganan ellos
                        return true;
                    }
                    if (this.ganador_segunda == true)
                    {
                        return null;
                    }
                }
                if (this.ganador_primera == null)
                {
                    if (this.ganador_segunda == true)
                    {
                        return true;
                    }
                    if (this.ganador_segunda == false)
                    {
                        return false;
                    }
                }
                return null;
            }
            if (this.vuelta == 3)
            {

                if (this.ganador_tercera != null)
                {
                    return this.ganador_tercera;
                }
                else
                {
                    return this.jugadores[this.id_mano].equipo;
                }
            }
            return null;
        }

        public Carta str_a_carta(string s)
        {
            foreach (Jugador j in this.jugadores)
            {
                foreach (Carta c in j.mano)
                {
                    if (c.ToString() == s)
                    {
                        return c;
                    }
                }
            }
            return null;
        }
    
